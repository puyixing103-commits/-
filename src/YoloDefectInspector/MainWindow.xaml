<Window x:Class="YoloDefectInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="YOLO 缺陷检测上位机" Height="780" Width="1240" MinHeight="650" MinWidth="980">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" CornerRadius="8" Background="#FFF7F7F7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0">
                    <TextBlock Text="模型路径" FontWeight="SemiBold"/>
                    <DockPanel>
                        <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="520" Height="30" VerticalContentAlignment="Center"/>
                        <Button Content="浏览" Command="{Binding BrowseModelCommand}" Margin="8,0,0,0" Padding="18,4"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="置信度阈值" FontWeight="SemiBold"/>
                    <TextBox Width="110" Height="30" Text="{Binding ConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="IoU 阈值" FontWeight="SemiBold"/>
                    <TextBox Width="110" Height="30" Text="{Binding IouThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="3" Content="加载模型" Command="{Binding LoadModelCommand}" Margin="0,18,12,0" Padding="20,8" Height="36"/>
                <Button Grid.Column="4" Content="开始检测" Command="{Binding RunDetectCommand}" Margin="0,18,0,0" Padding="20,8" Height="36"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#FFD9D9D9" CornerRadius="8" Background="#FFFAFAFA" Padding="6">
                <Grid>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                    <TextBlock Text="{Binding EmptyPreviewHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF8C8C8C" FontSize="18" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#FFD9D9D9" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock Text="检测结果" FontWeight="Bold" FontSize="16" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Defects}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类别" Binding="{Binding Label}" Width="1.6*"/>
                            <DataGridTextColumn Header="置信度" Binding="{Binding Confidence, StringFormat=F2}" Width="*"/>
                            <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F0}" Width="*"/>
                            <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F0}" Width="*"/>
                            <DataGridTextColumn Header="W" Binding="{Binding Width, StringFormat=F0}" Width="*"/>
                            <DataGridTextColumn Header="H" Binding="{Binding Height, StringFormat=F0}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding DefectSummary}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
